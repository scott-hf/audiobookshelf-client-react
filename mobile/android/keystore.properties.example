# WI-1496 t900 Task 6 -- placeholder shape ONLY, never a real path/password.
#
# This repo's build.gradle does not currently read a keystore.properties file (it reads the
# four ANDROID_KEYSTORE_* env vars directly -- see build.gradle's `hasReleaseSigningEnv` guard
# and .github/workflows/android-release.yml). This file documents the equivalent local-machine
# shape for a maintainer who prefers a properties file for a local signed build, per
# mobile/RELEASE.md's process doc. Copy to `keystore.properties` and fill in real values ONLY
# when running a local signed build with the real t950 keystore -- never commit the copy (this
# repo's mobile/android/.gitignore does not yet ignore `keystore.properties` by name; add it
# there before ever creating a real one locally).
storeFile=/path/to/release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
