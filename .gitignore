# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/

# workspace package build output (e.g. packages/acquisition-contract/dist)
dist/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
/local-scripts
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

express-server
*.vue
.idea

# Generated from foliate-js vendor (scripts/sync-pdfjs-vendor.mjs)
/public/vendor/pdfjs

# Generated from node-unrar-js (scripts/sync-unrar-wasm.mjs)
/public/vendor/unrar

# Android (mobile/) generated build output -- keep mobile/android checked in, ignore its build artifacts
mobile/android/**/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/**/*.apk
mobile/android/**/*.aab
mobile/android/**/.cxx/
mobile/android/captures/

# Playwright (mobile/e2e) run output
mobile/test-results/
mobile/playwright-report/