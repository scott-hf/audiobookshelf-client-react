# Non-secret Compose interpolation values (docs/handoff/05-DEPLOYMENT-CONTRACT.md).
# Copy to compose.env (do not commit that copy), fill in real values, then validate:
#   docker compose --env-file compose.env -f docker-compose.acquisition.yml config
GATEWAY_IMAGE=ghcr.io/REPLACE-WITH-OWNER/audiobookshelf-acquisition-gateway:latest
# Path (relative to this directory, or absolute) to the copied, mode-0600, secret
# gateway env file -- see acquisition-gateway.env.example.
GATEWAY_ENV_FILE=./acquisition-gateway.env
