# Secret gateway runtime environment (docs/handoff/05-DEPLOYMENT-CONTRACT.md). Copy to
# acquisition-gateway.env, chmod 0600, fill in real values. Never commit the copy.
#
# NOTE (WI-1496 t1000): variable names below match the ACTUAL gateway config parser
# (services/acquisition-gateway/src/config.ts), which is authoritative over
# docs/handoff/05-DEPLOYMENT-CONTRACT.md's table where the two have drifted -- see
# docs/implementation-status.md's t1000 section for the full drift list. In short:
# PUBLIC_BASE_PATH, AUTH_CACHE_SECONDS, ABS_RESOLUTION_TIMEOUT_SECONDS and LOG_LEVEL are
# documented in the contract but not read by config.ts; RECONCILE_INTERVAL_SECONDS and
# HISTORY_RETENTION_DAYS in the contract are actually RECONCILE_INTERVAL_MS and
# HISTORY_RETENTION_SECONDS (different names AND units) in the real parser; and
# STALL_TIMEOUT_SECONDS, FINAL_TREE_MODE, FINAL_TREE_FILE_MODE, FINAL_TREE_DIR_MODE, and
# IMPORT_CLEANUP_ENABLED are read by config.ts but not documented in the contract at all.
PORT=8080
ABS_INTERNAL_URL=http://audiobookshelf:13378
ABS_SERVICE_TOKEN=replace-with-abs-service-token
LIBRARR_INTERNAL_URL=http://librarr:5050
LIBRARR_API_KEY=replace-with-librarr-api-key
GATEWAY_DB_PATH=/data/gateway.sqlite
STAGING_ROOT=/media/staging
LIBRARY_MAPPINGS_JSON={"replace-with-abs-library-id":"/media/audiobooks"}
SEARCH_TTL_SECONDS=900
# TorBox with download_uncached accepts any hash and can sit at 0 B forever (FND-00410);
# this is the reconciler's stall-to-failed timeout for that case (WI-1496 correction #5).
STALL_TIMEOUT_SECONDS=1800
RECONCILE_INTERVAL_MS=15000
HISTORY_RETENTION_SECONDS=604800
# A staged tree is stable only after two identical fingerprints separated by this window
# (02-SETTLED-DECISIONS.md). Never 0 in production.
STAGING_STABILITY_SECONDS=30
# preserve (default) keeps what Librarr wrote; override applies FINAL_TREE_FILE_MODE /
# FINAL_TREE_DIR_MODE below. See docs/handoff/correlation-note.md section 4.
FINAL_TREE_MODE=preserve
FINAL_TREE_FILE_MODE=0644
FINAL_TREE_DIR_MODE=0755
# Deletes the staged tree AND Librarr's stale library row after a confirmed import
# (FND-00414 / in_library dedupe). Disable only for debugging a failed import.
IMPORT_CLEANUP_ENABLED=true
